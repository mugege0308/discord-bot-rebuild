DISCORD_BOT_TOKEN=DiscordのBotトークン
DISCORD_GUILD_ID=テスト用DiscordサーバーID

# 起動時の天気通知を送るチャンネルIDです。未設定なら起動時通知は送りません。
WEATHER_CHANNEL_ID=起動時の天気通知を送るチャンネルID

# 京都市の初期値です。別の場所にしたい場合は緯度・経度・表示名を変更してください。
WEATHER_LATITUDE=35.0116
WEATHER_LONGITUDE=135.7681
WEATHER_LOCATION_NAME=京都

# 日本時間で、この時刻以降に起動した場合、朝通知を確認します。
WEATHER_NOTIFY_AFTER_HOUR=6

# 日本時間で、この時刻以降に起動した場合、夕方通知を確認します。
WEATHER_EVENING_NOTIFY_AFTER_HOUR=18

# DiscordからPCシャットダウンを許可するユーザーIDです。複数ある場合はカンマ区切りにします。
PC_CONTROL_ALLOWED_USER_IDS=許可するDiscordユーザーIDをカンマ区切り

# DiscordからClaude Codeを起動する固定 .bat / .cmd の絶対パスです。
# /claude_start と /claude_status は PC_CONTROL_ALLOWED_USER_IDS のユーザーだけが使えます。
CLAUDE_START_FILE=C:\Users\PC_User\Documents\Codex\start_claude_code.bat

# Claude Code Remote Control。対象フォルダとセッション名はBot管理者が固定します。
# 各 /claude_remote_* コマンドは PC_CONTROL_ALLOWED_USER_IDS のユーザーだけが使えます。
CLAUDE_REMOTE_ENABLED=false
CLAUDE_REMOTE_COMMAND=claude
CLAUDE_REMOTE_PROJECT_DIR=
CLAUDE_REMOTE_SESSION_NAME=初号ちゃん
CLAUDE_REMOTE_START_TIMEOUT_SECONDS=30
CLAUDE_REMOTE_STOP_TIMEOUT_SECONDS=10

# ローカルVOICEVOXを使うVC読み上げ設定です。API URLはローカルホストだけ許可されます。
VOICEVOX_API_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=1
VOICEVOX_REQUEST_TIMEOUT_SECONDS=30
VC_SAY_MAX_LENGTH=200

# /pc_shutdown で確認後、何秒後にシャットダウンするかを指定します。
PC_SHUTDOWN_DELAY_SECONDS=60

# ローカル画像生成操作設定
# Stability Matrix の ComfyUI を使う場合は comfy / 8188 を指定します。
SD_BACKEND=comfy
SD_API_URL=http://127.0.0.1:8188

# 起動するbat/cmd/exeを固定パスで指定してください。任意コマンド実行はしません。
# 例: C:\Users\i\stable-diffusion-webui\webui-user.bat
SD_START_FILE=
SD_START_CWD=

# SD_BACKEND=comfy の場合、/sd_start はこちらを優先して起動します。
# ComfyUIを起動する .bat / .cmd / .exe の固定パスを指定してください。
COMFYUI_START_FILE=C:\Users\PC_User\Documents\Codex\2026-06-23\discord-bot-python-discord-py-pc\start_comfyui.bat

# 生成上限。Discord経由で重くしすぎないための安全設定です。
SD_MAX_COUNT=10
SD_MAX_WIDTH=1024
SD_MAX_HEIGHT=1024
SD_MAX_STEPS=60
SD_MAX_CFG=20

# negative_prompt 未指定時に使う既定値です。
SD_DEFAULT_NEGATIVE_PROMPT=low quality, worst quality, bad anatomy, extra fingers, missing fingers, bad hands, blurry, jpeg artifacts, watermark, text, logo

# Botの状態点検を定期的にDiscordへ通知する設定です。
# HEALTH_CHECK_CHANNEL_ID が未設定の場合、定期通知は送信しません。
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_INTERVAL_MINUTES=60
HEALTH_CHECK_CHANNEL_ID=状態点検を送るDiscordチャンネルID

# LM Studio / OpenAI互換APIを使う場合の疎通確認用URLです。
# 例: http://127.0.0.1:1234/v1
LMSTUDIO_API_URL=http://127.0.0.1:1234/v1
LMSTUDIO_TEXT_MODEL=テキスト用モデルID
LMSTUDIO_VISION_MODEL=Vision用モデルID

# 後方互換用のフォールバックです。
# LMSTUDIO_TEXT_MODEL / LMSTUDIO_VISION_MODEL が未設定の場合に使います。
LMSTUDIO_MODEL=local-model
LM_STUDIO_API_URL=

# ComfyUI の API形式Workflow JSONを指定します。
# ComfyUIでWorkflowを保存するときは、API formatで保存したJSONを使ってください。
COMFY_WORKFLOW_FILE=workflows/comfy_workflow.json

# 通常は未設定で問題ありません。
# BotがKSamplerのpositive/negative接続、RandomNoise/seed入力、SaveImageを自動検出します。
# 自動検出が合わない特殊なWorkflowだけ、Workflow JSON内のノードIDで上書きしてください。
COMFY_POSITIVE_NODE_ID=
COMFY_NEGATIVE_NODE_ID=
COMFY_SEED_NODE_ID=

# 画像生成後に既存の画像選別AIを使う場合に設定します。
# 未設定の場合、画像選別AIはスキップされ、通常の生成画像を返します。
LOCAL_AI_PROJECT_DIR=C:\Users\PC_User\Documents\Codex\2026-07-04\ai-phase-1-comfyui-outputs-raw\local_ai_project
SD_SELECT_GENERATE_COUNT=5
SD_SELECT_RETURN_COUNT=1

# DiscordからBot自身を再起動するときに起動する .bat / .cmd / .exe のフルパスです。
BOT_START_FILE=C:\Users\PC_User\Documents\Codex\2026-06-23\discord-bot-python-discord-py-pc\start_bot.bat

# 開発タスク（/dev_task, /dev_task_status, /dev_task_stop）を許可するユーザーIDです。
# 複数ある場合はカンマ区切りにします。PC_CONTROL_ALLOWED_USER_IDSとは別の設定です。
DEV_TASK_ALLOWED_USER_IDS=許可するDiscordユーザーIDをカンマ区切り

# /character_missing（生成履歴の中から辞書未解決の候補を集計する診断コマンド）を
# 許可するユーザーIDです。複数ある場合はカンマ区切りにします。他ユーザーの生成履歴の
# 元入力が見える可能性があるため、PC_CONTROL_ALLOWED_USER_IDS等とは別の専用設定です。
# /character_list・/character_info・/character_search・/character_validate は
# 辞書自体の読み取り専用表示のみで、この設定の対象外です（一般利用可）。
CHARACTER_ADMIN_ALLOWED_USER_IDS=許可するDiscordユーザーIDをカンマ区切り

# 開発タスク1件あたりの実行時間の上限（秒）です。Phase 3のダミー実行では
# 実際にはごく短時間しか使いませんが、Phase 4以降の実行にも使う値です。
DEV_TASK_TIMEOUT_SECONDS=1800

# 開発タスクの実行結果を、起票者へのDMが失敗した場合に代わりに送るチャンネルIDです。
# 未設定の場合、DM失敗時は通知できず、ログにのみ記録されます。
DEV_TASK_RESULT_CHANNEL_ID=

# /dev_task でbase_branchを省略した場合に使う既定のベースブランチです。
DEV_TASK_DEFAULT_BASE_BRANCH=master

# Phase 4A: Claude Codeのheadless試験実行。
# 既定は無効です。/dev_task経由の自動実行にはまだ接続されておらず、
# services.claude_headless / services.dev_copy_workspace を直接使った
# 単体の試験実行にのみ使用します（詳細はREADMEの該当節を参照）。
CLAUDE_HEADLESS_ENABLED=false

# Claude Code CLIの実行ファイルへの絶対パスです（相対パスは不可）。
# 例: C:\Users\PC_User\.local\bin\claude.exe
CLAUDE_CLI_PATH=

# Claude Code 1回のheadless実行あたりの最大実行時間（秒）です。30〜86400の範囲で
# 指定してください。範囲外や不正な値は既定値にフォールバックします。
CLAUDE_HEADLESS_TIMEOUT_SECONDS=1800

# Claude Codeの標準出力/標準エラー出力それぞれについて、保持する最大バイト数です。
# 1024〜52428800（50MiB）の範囲で指定してください。超過分は安全に切り詰められます。
CLAUDE_HEADLESS_MAX_OUTPUT_BYTES=1048576

# Claude Code CLIの認証にAPIキーが必要な場合だけ設定してください。
# --bare実行のためOAuth/keychain認証は使えません。Botの他の環境変数からは
# 絶対に継承せず、この専用設定からのみ、許可された環境変数一覧に追加されます。
# 未設定なら渡しません。
CLAUDE_HEADLESS_ANTHROPIC_API_KEY=

# 実行モード。現時点ではisolated_copy（隔離コピー方式）のみ対応です。
# それ以外の値（例: worktree）は安全に拒否されます。
CLAUDE_HEADLESS_WORKSPACE_MODE=isolated_copy

# 隔離コピー（サンドボックス）を作成する絶対パスです。未設定の場合、
# サンドボックスは作成できず、Claudeのheadless試験実行も安全に失敗します。
# 本体リポジトリと同一・その配下・その親（本体を包含する配置）は設定しても
# 安全に拒否されます（サンドボックス作成前・Claude起動前に失敗します）。
# 例: C:\Users\PC_User\Documents\Codex\dev-task-sandboxes
DEV_TASK_SANDBOX_ROOT=

# サンドボックスへコピーするファイル数の上限です。超過時はコピーを中止し、
# 作成しかけたサンドボックスは削除します。
DEV_TASK_SANDBOX_MAX_FILES=5000

# サンドボックスへコピーする合計バイト数の上限です。超過時はコピーを中止し、
# 作成しかけたサンドボックスは削除します。
DEV_TASK_SANDBOX_MAX_TOTAL_BYTES=524288000

# Qwen-Image 2.1 backend adapter is opt-in and remains disabled by default.
ENABLE_QWEN_IMAGE_2_1=0
